\f1\b \cf0 Objetivo:
\f0\b0  Devolver "Par" o "Impar" seg\'fan si el n\'famero de entrada es divisible por 2.\
\
\pard\pardeftab720\sa280\partightenfactor0

\f1\b\fs28 \cf0 Funci\'f3n 
\f2\fs30\fsmilli15210 def
\f1\fs28  tradicional:\
\pard\pardeftab720\sa240\partightenfactor0

\f0\b0\fs24 \cf0 \
\pard\pardeftab720\partightenfactor0
\cf0 Python\
\
\pard\pardeftab720\partightenfactor0

\f3\fs26 \cf0 def verificar_paridad(numero):\
    """Devuelve 'Par' si el n\'famero es par, 'Impar' si es impar."""\
    if numero % 2 == 0:\
        return "Par"\
    else:\
        return "Impar"\
\
# Ejemplo de uso:\
# resultado = verificar_paridad(7) # 'Impar'\
\pard\pardeftab720\sa240\partightenfactor0

\f0\fs24 \cf0 \
